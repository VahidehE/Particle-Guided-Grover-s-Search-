Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Gaussian", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mu", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigma", "=", 
     RowBox[{"10", "^", "3"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"gaussianPDF", "[", "x_", "]"}], ":=", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"mu", ",", "sigma"}], "]"}], ",", "x"}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "compute", " ", "exact", " ", "discrete", " ",
      "KL", " ", "divergence", " ", "between", " ", 
     RowBox[{"Uniform", "[", 
      RowBox[{"a", ",", "b"}], "]"}], " ", "and", " ", "Gaussian"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"KLDiscreteUniformVsGaussian", "[", 
     RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xs", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"a", ",", "b"}], "]"}]}], ",", 
        RowBox[{"n", "=", 
         RowBox[{"b", "-", "a", "+", "1"}]}], ",", 
        RowBox[{"p", "=", 
         RowBox[{"1.0", "/", 
          RowBox[{"(", 
           RowBox[{"b", "-", "a", "+", "1"}], ")"}]}]}]}], "}"}], ",", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "*", 
          RowBox[{"Log", "[", 
           RowBox[{"p", "/", 
            RowBox[{"gaussianPDF", "[", "#", "]"}]}], "]"}]}], "&"}], "/@", 
        "xs"}], "]"}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "for", " ", "the", " ", "two", " ", "uniform", " ", 
     "distributions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kl1", "=", 
     RowBox[{"KLDiscreteUniformVsGaussian", "[", 
      RowBox[{"1", ",", 
       RowBox[{"Floor", "[", 
        RowBox[{
         RowBox[{"10", "^", "6"}], "/", "4"}], "]"}]}], "]"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"kl2", "=", 
     RowBox[{"KLDiscreteUniformVsGaussian", "[", 
      RowBox[{"1", ",", 
       RowBox[{"Floor", "[", 
        RowBox[{
         RowBox[{"10", "^", "7"}], "/", "4"}], "]"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Exact KL(U[1, 10^6/4] || N(10, 10^6)) = \>\"", ",", "kl1"}], 
    "]"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Exact KL(U[1, 10^7/4] || N(10, 10^6)) = \>\"", ",", "kl2"}], 
    "]"}], "\n", "\n", "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.960277859871359*^9, 3.960277866766776*^9}, {
  3.960277974504816*^9, 3.960277982751115*^9}, {3.960278431327509*^9, 
  3.960278435701295*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"db4375f5-f68d-43c8-96ac-db303e33f6b1"],

